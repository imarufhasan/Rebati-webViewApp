# ==============================================================
# Rebati (Expo React Native) - Production .gitignore
# Package: com.marufhasan.rebati
# ==============================================================

# 📦 Dependencies
node_modules/
.pnp
.pnp.js

# 📱 Expo & EAS Build
.expo/
dist/
web-build/
expo-env.d.ts
.eas/
*.aab
*.apk
*.ipa

# 🔐 Security, Google Play Service Account & Signing Keys (CRITICAL)
# Never commit your Google Play API key or Android keystores!
google-service-account.json
*service-account*.json
pc-api-*.json
play-store-key.json
credentials.json
credentials/
*.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# ⚙️ Environment Variables (Keep secrets private)
.env
.env.local
.env*.local
!.env.example

# 🤖 Native Generated Folders (Expo Config Plugins generate these in EAS)
/ios/
/android/
.kotlin/
.gradle/
build/
*.orig.*

# 🚇 Metro Bundler & Package Managers
.metro-health-check*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 💻 Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 🛠️ IDE & Editor Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo

# 📘 TypeScript
*.tsbuildinfo

# 🗂️ Template & Example Folders
app-example/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
